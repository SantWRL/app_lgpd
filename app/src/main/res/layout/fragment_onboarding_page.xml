<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:cardCornerRadius="28dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/pageIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@string/app_name"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shield_lock"
            app:tint="@color/white" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textAppearance="@style/TextAppearance.LGPD.ScreenTitle"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:text="Título da Página" />

    <TextView
        android:id="@+id/pageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6sp"
        android:textAppearance="@style/TextAppearance.LGPD.Body"
        android:textColor="#E2E8F0"
        android:textAlignment="center"
        android:text="Subtítulo da página" />

</LinearLayout>
