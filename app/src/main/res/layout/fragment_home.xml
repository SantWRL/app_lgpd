<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp">

        <!-- ── Header: Avatar + Greeting + Notification ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- Avatar Circle -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="US"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Greeting -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá, Usuário!"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprenda LGPD!"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Notification Bell -->
            <FrameLayout
                android:id="@+id/notificationBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_panel_frost"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notificações"
                    android:src="@drawable/ic_shield_lock"
                    app:tint="@color/white" />

                <!-- Badge indicando que o lembrete está ativo -->
                <View
                    android:id="@+id/reminderBadge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/success"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- ── Hero Banner: Progresso (LinearGradient card) ── -->
        <LinearLayout
            android:id="@+id/heroBanner"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_hero_banner"
            android:orientation="horizontal"
            android:padding="26dp">

            <!-- Left: Texto e botão -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="10dp">

                <!-- Badge "SUA JORNADA" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/hero_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="SUA JORNADA"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Continue Evoluindo"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Você já completou 0% do conteúdo essencial."
                    android:textColor="#CCE2E8F0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnVerDetalhes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:minHeight="0dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Ver Detalhes"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Right: Porcentagem circular -->
            <LinearLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_panel_frost"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/progressPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="56dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Seção: Categorias (horizontal chips) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categorias"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todas"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoriesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/catAll"
                    style="@style/CategoryPill.Active"
                    android:text="Todos" />

                <TextView
                    android:id="@+id/catFundamentos"
                    style="@style/CategoryPill"
                    android:text="Fundamentos" />

                <TextView
                    android:id="@+id/catConformidade"
                    style="@style/CategoryPill"
                    android:text="Conformidade" />

                <TextView
                    android:id="@+id/catDireitos"
                    style="@style/CategoryPill"
                    android:text="Direitos" />

                <TextView
                    android:id="@+id/catAtores"
                    style="@style/CategoryPill"
                    android:text="Atores" />

                <TextView
                    android:id="@+id/catSeguranca"
                    style="@style/CategoryPill"
                    android:text="Segurança" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ── Seção: Cursos em Destaque ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cursos em Destaque"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lessonsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginBottom="32dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            tools:listitem="@layout/item_lesson_card" />

        <!-- ── Seção: Gamificação ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gamificação"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Cards de minigames lado a lado -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <!-- Card Wordle / Termo da Privacidade -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWordle"
                    android:layout_width="240dp"
                    android:layout_height="208dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_wordle_promo"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#33000000"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="MINI-GAME"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="+10 XP"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/badge_background"
                            android:backgroundTint="#40FFFFFF">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="\uD83D\uDD0D"
                                android:textSize="24sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Termo da Privacidade"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp"
                            android:text="Adivinhe a palavra secreta sobre privacidade de dados"
                            android:textColor="#CCE2E8F0"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:text="Jogar  →"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card Caça-Palavras Legal -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWordsearch"
                    android:layout_width="240dp"
                    android:layout_height="208dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_wordsearch_promo"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#33000000"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="MINI-GAME"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="+10 XP"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/badge_background"
                            android:backgroundTint="#40FFFFFF">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="\uD83D\uDD0E"
                                android:textSize="24sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Caça-Palavras Legal"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp"
                            android:text="Encontre os termos da LGPD escondidos no grid"
                            android:textColor="#CCE2E8F0"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:text="Jogar  →"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card Quiz Relâmpago -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuizRelampago"
                    android:layout_width="240dp"
                    android:layout_height="208dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_quizpromo"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#33000000"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="RELÂMPAGO"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="+5 XP"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/quizRecordeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/badge_background"
                            android:backgroundTint="#40FFFFFF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Recorde: --"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/badge_background"
                            android:backgroundTint="#40FFFFFF">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="\u26A1"
                                android:textSize="28sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quiz Relâmpago"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="6dp"
                            android:text="Responda perguntas aleatórias contra o tempo"
                            android:textColor="#CCE2E8F0"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="#40FFFFFF"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:text="Jogar  →"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ── Seção: Recursos e Apoio (mentor cards horizontais) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recursos e Apoio"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <!-- Card: Portal ANPD -->
                <LinearLayout
                    android:id="@+id/cardAnpd"
                    android:layout_width="150dp"
                    android:layout_height="188dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_card_anpd"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#40FFFFFF">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Portal ANPD"
                            android:src="@drawable/ic_shield_lock"
                            app:tint="@color/white" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="Portal ANPD"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Resoluções e orientações."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card: LGPD x GDPR -->
                <LinearLayout
                    android:id="@+id/cardGdpr"
                    android:layout_width="150dp"
                    android:layout_height="188dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_card_gdpr"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#40FFFFFF">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="GDPR"
                            android:src="@drawable/ic_book"
                            app:tint="@color/white" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="LGPD × GDPR"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Semelhanças e diferenças."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card: Resumo Legal -->
                <LinearLayout
                    android:id="@+id/cardResumo"
                    android:layout_width="150dp"
                    android:layout_height="188dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_card_resumo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#40FFFFFF">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Resumo"
                            android:src="@drawable/ic_check"
                            app:tint="@color/white" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="Resumo Legal"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Essência da Lei nº 13.709."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card: Dicionário Jurídico -->
                <LinearLayout
                    android:id="@+id/cardDicionario"
                    android:layout_width="150dp"
                    android:layout_height="188dp"
                    android:background="@drawable/bg_card_dicionario"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#40FFFFFF">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Dicionário"
                            android:src="@drawable/ic_star"
                            app:tint="@color/white" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="Dicionário Jurídico"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Conceitos fundamentais."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Card: e-CAD Digital (Lei 15.211/2025) -->
                <LinearLayout
                    android:id="@+id/cardECad"
                    android:layout_width="150dp"
                    android:layout_height="188dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_ecad_promo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge "NOVA LEI" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#33000000"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="NOVA LEI"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#40FFFFFF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="\uD83D\uDEE1\uFE0F"
                            android:textSize="22sp" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Estatuto Digital"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteção de crianças e adolescentes."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ── Seção: Notícias (carrossel horizontal animado) ── -->
        <LinearLayout
            android:id="@+id/newsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="\uD83D\uDD25 Notícias da ANPD"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerNoticias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Ver todas"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeNewsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:scrollbars="none"
                tools:listitem="@layout/item_feed_post_compact" />

        </LinearLayout>

        <!-- ── Seção: Testes Rápidos ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Testes Rápidos"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quizzesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            tools:listitem="@layout/item_quiz_card" />

    </LinearLayout>

</ScrollView>
