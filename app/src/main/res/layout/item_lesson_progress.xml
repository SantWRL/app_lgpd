<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="170dp"
    android:layout_height="176dp"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/primary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Icon -->
        <FrameLayout
            android:id="@+id/statusIconFrame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/badge_background"
            android:backgroundTint="@color/surface_variant">

            <TextView
                android:id="@+id/statusIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/text_tertiary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="✓" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/lessonTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Introdução à LGPD"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            tools:text="Introdução à LGPD" />

        <!-- Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/categoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/primary_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Fundamentos"
                android:textColor="@color/primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1"
                tools:text="Fundamentos" />

            <TextView
                android:id="@+id/difficultyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/success_light"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="INIC"
                android:textColor="@color/success"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1"
                tools:text="INIC" />
        </LinearLayout>

        <!-- Status line -->
        <TextView
            android:id="@+id/completedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pendente"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            tools:text="Concluída" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
