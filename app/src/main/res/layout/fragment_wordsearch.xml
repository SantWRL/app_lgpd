<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAÇA-PALAVRAS"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encontre os termos da LGPD"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Palavras restantes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvWordsLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="restantes"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Grade do Caça-Palavras -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:padding="8dp">

            <GridLayout
                android:id="@+id/searchGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="10"
                android:rowCount="10" />

        </LinearLayout>

    </LinearLayout>

    <!-- Lista de Palavras a Encontrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:layout_margin="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encontre as palavras:"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Linha 1 de palavras -->
        <LinearLayout
            android:id="@+id/wordChipsRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/chip_0"
                style="@style/WordChip"
                android:text="DADOS" />

            <TextView
                android:id="@+id/chip_1"
                style="@style/WordChip"
                android:text="BASES" />

            <TextView
                android:id="@+id/chip_2"
                style="@style/WordChip"
                android:text="RISCO" />

        </LinearLayout>

        <!-- Linha 2 de palavras -->
        <LinearLayout
            android:id="@+id/wordChipsRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_3"
                style="@style/WordChip"
                android:text="MULTA" />

            <TextView
                android:id="@+id/chip_4"
                style="@style/WordChip"
                android:text="FINAL" />

        </LinearLayout>

        <!-- Botão Novo Jogo -->
        <Button
            android:id="@+id/btnNewWordSearch"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="Novo Jogo 🎉" />

    </LinearLayout>

</LinearLayout>
